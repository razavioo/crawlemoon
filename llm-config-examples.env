# ============================================================================
# Crawlemoon MCP Server - LLM Configuration Examples
# ============================================================================
# 
# The smart_extract tool works WITHOUT any paid API using pattern matching.
# Optionally, you can enable LLM enhancement for better extraction accuracy.
# 
# Supports any OpenAI-compatible API - including FREE options!
# ============================================================================

# ============================================================================
# OPTION 1: OpenRouter (Recommended - Many FREE models available!)
# ============================================================================
# Sign up at: https://openrouter.ai
# Get API key from: https://openrouter.ai/keys
# Free models: https://openrouter.ai/docs/models (filter by "free")

# CRAWLEMOON_LLM_PROVIDER=openrouter
# CRAWLEMOON_LLM_API_KEY=sk-or-v1-your-key-here
# CRAWLEMOON_LLM_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Other free OpenRouter models:
# - google/gemma-2-9b-it:free
# - microsoft/phi-3-mini-128k-instruct:free
# - qwen/qwen-2-7b-instruct:free

# ============================================================================
# OPTION 2: Groq (FREE tier, very fast!)
# ============================================================================
# Sign up at: https://console.groq.com
# Get API key from: https://console.groq.com/keys
# Free tier: 14,400 tokens/minute on Llama models

# CRAWLEMOON_LLM_PROVIDER=groq
# CRAWLEMOON_LLM_API_KEY=gsk_your-key-here
# CRAWLEMOON_LLM_MODEL=llama-3.1-8b-instant

# Other Groq models:
# - llama-3.1-70b-versatile (slower but smarter)
# - mixtral-8x7b-32768 (good balance)
# - gemma2-9b-it (fast)

# ============================================================================
# OPTION 3: Ollama (100% FREE - runs locally on your machine)
# ============================================================================
# Install Ollama: https://ollama.ai
# Run: ollama pull llama3.2
# No API key needed!

# CRAWLEMOON_LLM_PROVIDER=ollama
# CRAWLEMOON_LLM_MODEL=llama3.2

# Other Ollama models (run `ollama list` to see installed):
# - llama3.2:1b (fastest, smallest)
# - llama3.1 (better quality)
# - mistral (good balance)
# - phi3 (small and fast)
# - qwen2.5 (good for extraction)

# ============================================================================
# OPTION 4: Together AI (Free tier available)
# ============================================================================
# Sign up at: https://together.ai
# Get API key from: https://api.together.xyz/settings/api-keys
# Free tier: $25 credits for new users

# CRAWLEMOON_LLM_PROVIDER=together
# CRAWLEMOON_LLM_API_KEY=your-together-api-key
# CRAWLEMOON_LLM_MODEL=meta-llama/Llama-3.2-3B-Instruct-Turbo

# ============================================================================
# OPTION 5: DeepSeek (Very affordable - $0.14/million tokens)
# ============================================================================
# Sign up at: https://platform.deepseek.com
# Very affordable pricing, good quality

# CRAWLEMOON_LLM_PROVIDER=deepseek
# CRAWLEMOON_LLM_API_KEY=sk-your-deepseek-key
# CRAWLEMOON_LLM_MODEL=deepseek-chat

# ============================================================================
# OPTION 6: OpenAI (Paid, highest quality)
# ============================================================================
# Sign up at: https://platform.openai.com
# gpt-4o-mini is affordable at ~$0.15/million tokens

# CRAWLEMOON_LLM_PROVIDER=openai
# CRAWLEMOON_LLM_API_KEY=sk-your-openai-key
# CRAWLEMOON_LLM_MODEL=gpt-4o-mini

# ============================================================================
# OPTION 7: Custom OpenAI-compatible endpoint
# ============================================================================
# For any other OpenAI-compatible API (KiloCode, Factory.ai, MegaLLM, etc.)
# Just provide the base URL directly:

# CRAWLEMOON_LLM_BASE_URL=https://your-custom-api.com/v1
# CRAWLEMOON_LLM_API_KEY=your-api-key
# CRAWLEMOON_LLM_MODEL=your-model-name

# ============================================================================
# MCP Server Configuration (for Cursor/Claude Desktop)
# ============================================================================
# 
# Add to your ~/.cursor/mcp.json or claude_desktop_config.json:
#
# {
#   "mcpServers": {
#     "crawlemoon": {
#       "command": "uv",
#       "args": ["run", "-m", "src.mcp.server"],
#       "cwd": "/path/to/crawlemoon-mcp-server",
#       "env": {
#         "CRAWLEMOON_LLM_PROVIDER": "openrouter",
#         "CRAWLEMOON_LLM_API_KEY": "sk-or-v1-your-key",
#         "CRAWLEMOON_LLM_MODEL": "meta-llama/llama-3.2-3b-instruct:free"
#       }
#     }
#   }
# }
#
# Or for local Ollama (no API key needed):
#
# {
#   "mcpServers": {
#     "crawlemoon": {
#       "command": "uv",
#       "args": ["run", "-m", "src.mcp.server"],
#       "cwd": "/path/to/crawlemoon-mcp-server",
#       "env": {
#         "CRAWLEMOON_LLM_PROVIDER": "ollama",
#         "CRAWLEMOON_LLM_MODEL": "llama3.2"
#       }
#     }
#   }
# }
# ============================================================================
